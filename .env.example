# Required secrets — never commit real values.
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
FREEMODEL_API_KEY=replace_with_freemodel_key

# FreeModel OpenAI-compatible endpoint and optional model override.
FREEMODEL_BASE_URL=https://freemodel.in/v1
FREEMODEL_MODEL=

# Public group username from https://t.me/Pixel_Mediair
TARGET_CHAT_USERNAME=Pixel_Mediair
# Use a numeric ID instead for a private group; when set, it takes precedence.
TARGET_CHAT_ID=

IDLE_MINUTES=15
TOPIC_COOLDOWN_MINUTES=60
REPLY_COOLDOWN_SECONDS=60
CHECK_INTERVAL_SECONDS=20
LOG_LEVEL=INFO
