# Required secrets — never commit real values.
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
COARENA_API_KEY=replace_with_coarena_key
RADOXAI_API_KEY=
# Optional numeric Telegram user ID; keep the actual value private in Railway Variables.
CREATOR_TELEGRAM_ID=
MODEL_OWNER_TELEGRAM_ID=8524573838

# OpenAI-compatible model providers. Configure at least one API key.
COARENA_BASE_URL=https://coarena.ai/api/v1
COARENA_MODEL=deepseek-v4-1-flash-1017
RADOXAI_BASE_URL=https://radoxai.com/v1
RADOXAI_MODEL=deepseek-v4-flash-0731
LLM_PROVIDER=coarena
BOT_TONE=friendly
BOT_DB_PATH=./data/bot_state.sqlite3

# Public group username from https://t.me/Pixel_Mediair
TARGET_CHAT_USERNAME=Pixel_Mediair
# Use a numeric ID instead for a private group; when set, it takes precedence.
TARGET_CHAT_ID=

IDLE_MINUTES=15
TOPIC_COOLDOWN_MINUTES=60
REPLY_COOLDOWN_SECONDS=60
CHECK_INTERVAL_SECONDS=20
NEWS_SEARCH_ENABLED=true
NEWS_SEARCH_MAX_RESULTS=4
NEWS_CACHE_TTL_SECONDS=300
# RAM fallback cache only; persistent history/preferences use the TTLs below.
CONVERSATION_TTL_MINUTES=15
CONVERSATION_MAX_MESSAGES=12
CONVERSATION_HISTORY_TTL_DAYS=30
USER_MEMORY_TTL_DAYS=30
USER_MEMORY_MAX_ITEMS=5
WEEKLY_TOPIC_INTERVAL_DAYS=7
INTERACTION_COOLDOWN_SECONDS=120
WEEKLY_INTERACTION_INTERVAL_DAYS=7
WEEKLY_INTERACTION_FIRST_DELAY_HOURS=24
WEEKLY_INTERACTION_SPACING_HOURS=84
TOPIC_RETRY_COOLDOWN_SECONDS=900
LOG_LEVEL=INFO
